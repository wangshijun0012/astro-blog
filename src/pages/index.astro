---
// 🚀 彻底抛弃笨重的 Node.js SDK，改用边缘节点原生的 Web Fetch API
const token = import.meta.env.NOTION_TOKEN || Astro.locals.runtime?.env?.NOTION_TOKEN;
const dbId = import.meta.env.NOTION_DATABASE_ID || Astro.locals.runtime?.env?.NOTION_DATABASE_ID;

let posts = [];
let errorMsg = '';

try {
  if (!token || !dbId) {
    throw new Error(`环境变量丢失！Token: ${!!token}, DB: ${!!dbId}`);
  }

  // 1. 使用原生 fetch 直接调用 Notion API
  const response = await fetch(`https://api.notion.com/v1/databases/${dbId}/query`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${token}`,
      'Notion-Version': '2022-06-28', // Notion API 版本要求
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      filter: { property: 'Status', select: { equals: 'Published' } }
    })
  });

  // 2. 捕捉 API 层面的错误
  if (!response.ok) {
    const errData = await response.json();
    throw new Error(`Notion API 报错: ${response.status} - ${errData.message}`);
  }

  const data = await response.json();

  // 3. 解析数据
  posts = data.results.map((page: any) => ({
    title: page.properties?.Name?.title[0]?.plain_text || '未命名',
    slug: page.properties?.Slug?.rich_text[0]?.plain_text || page.id,
  }));

} catch (error: any) {
  errorMsg = error.message;
  console.error("数据加载异常:", errorMsg);
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>我的 Notion 动态博客</title>
  </head>
  <body style="font-family: sans-serif; padding: 2rem;">
    <h1>我的动态博客 (Edge 原生极速版)</h1>
    
    {errorMsg ? (
      <div style="color: white; background-color: #ff4d4f; padding: 1rem; border-radius: 4px;">
        <p><strong>数据加载失败：</strong></p>
        <p>{errorMsg}</p>
      </div>
    ) : posts.length === 0 ? (
      <p>暂时没有文章，请在 Notion 中将文章的 Status 设置为 Published。</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li style="margin-bottom: 10px;">
            <strong>{post.title}</strong> (路由: /{post.slug})
          </li>
        ))}
      </ul>
    )}
  </body>
</html>