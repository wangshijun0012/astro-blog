---
import { Client } from '@notionhq/client';

// 1. 初始化 Notion 客户端 (会自动读取 Cloudflare 里的环境变量)
const notion = new Client({ auth: import.meta.env.NOTION_TOKEN });
const dbId = import.meta.env.NOTION_DATABASE_ID;

let posts = [];
let errorMsg = '';

// 2. 动态请求 Notion 数据
try {
  const response = await notion.databases.query({
    database_id: dbId,
    // 过滤出 Status 为 Published 的文章 (对应您截图中的配置)
    filter: { property: 'Status', select: { equals: 'Published' } },
  });

  posts = response.results.map((page: any) => ({
    title: page.properties.Name.title[0]?.plain_text || '未命名',
    slug: page.properties.Slug.rich_text[0]?.plain_text || page.id,
  }));
} catch (error: any) {
  errorMsg = error.message;
  console.error("Notion API 请求失败:", errorMsg);
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>我的 Notion 动态博客</title>
  </head>
  <body style="font-family: sans-serif; padding: 2rem;">
    <h1>我的动态博客</h1>
    
    {errorMsg ? (
      <div style="color: red;">
        <p>数据加载失败，请检查 Cloudflare 环境变量是否填写正确：</p>
        <p>{errorMsg}</p>
      </div>
    ) : posts.length === 0 ? (
      <p>暂时没有文章，请在 Notion 中将文章的 Status 设置为 Published。</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li style="margin-bottom: 10px;">
            {/* 这里先用纯文本展示，等打通后再做跳转链接 */}
            <strong>{post.title}</strong> (路由: /{post.slug})
          </li>
        ))}
      </ul>
    )}
  </body>
</html>