---
import { Client } from '@notionhq/client';

// 🚀 核心修复：同时兼容本地开发 (import.meta.env) 和 Cloudflare 边缘环境 (Astro.locals.runtime.env)
const token = import.meta.env.NOTION_TOKEN || Astro.locals.runtime?.env?.NOTION_TOKEN;
const dbId = import.meta.env.NOTION_DATABASE_ID || Astro.locals.runtime?.env?.NOTION_DATABASE_ID;

let posts = [];
let errorMsg = '';

try {
  // 增加空值拦截，防止容器崩溃
  if (!token || !dbId) {
    throw new Error(`环境变量未读取到！Token存在: ${!!token}, DB存在: ${!!dbId}`);
  }

  // 1. 初始化 Notion 客户端
  const notion = new Client({ auth: token });

  // 2. 动态请求 Notion 数据
  const response = await notion.databases.query({
    database_id: dbId,
    filter: { property: 'Status', select: { equals: 'Published' } },
  });

  posts = response.results.map((page: any) => ({
    title: page.properties.Name?.title[0]?.plain_text || '未命名',
    slug: page.properties.Slug?.rich_text[0]?.plain_text || page.id,
  }));
} catch (error: any) {
  errorMsg = error.message;
  console.error("Notion API 异常:", error);
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>我的 Notion 动态博客</title>
  </head>
  <body style="font-family: sans-serif; padding: 2rem;">
    <h1>我的动态博客</h1>
    
    {errorMsg ? (
      <div style="color: red;">
        <p>数据加载失败：</p>
        <p>{errorMsg}</p>
      </div>
    ) : posts.length === 0 ? (
      <p>暂时没有文章，请在 Notion 中将文章的 Status 设置为 Published。</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li style="margin-bottom: 10px;">
            <strong>{post.title}</strong> (路由: /{post.slug})
          </li>
        ))}
      </ul>
    )}
  </body>
</html>