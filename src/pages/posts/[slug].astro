---
import { Client } from '@notionhq/client';
import { NotionToMarkdown } from 'notion-to-md';
import { marked } from 'marked'; // 需额外 npm i marked

const { slug } = Astro.params;
const notion = new Client({ auth: import.meta.env.NOTION_TOKEN });
const n2m = new NotionToMarkdown({ notionClient: notion });

// 1. 安全校验：根据 slug 且状态为 Published 查询页面
const response = await notion.databases.query({
  database_id: import.meta.env.NOTION_DATABASE_ID,
  filter: {
    and: [
      { property: 'Slug', rich_text: { equals: slug as string } },
      { property: 'Status', select: { equals: 'Published' } }
    ]
  }
});

const page = response.results[0];
if (!page) return Astro.redirect('/404'); // 路由熔断：查不到或未发布直接 404

// 2. 解析正文块并渲染为 HTML
const mdblocks = await n2m.pageToMarkdown(page.id);
const mdString = n2m.toMarkdownString(mdblocks);
const contentHtml = marked.parse(mdString.parent);
const title = page.properties.Name.title[0]?.plain_text;
---

<html lang="zh">
  <head><title>{title}</title></head>
  <body>
    <article set:html={contentHtml} />
    <br/>
    <a href="/">← 返回首页</a>
  </body>
</html>